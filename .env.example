# Optional: Binance API keys for testnet execution (market data works without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Bot configuration
DAILY_PROFIT_TARGET_USD=5.0
INITIAL_CAPITAL_USD=1000.0
MAX_DAILY_LOSS_USD=15.0
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=INFO

# Data
EXCHANGE=okx
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,OKB/USDT
TIMEFRAME=1m
LOOKBACK_BARS=500
